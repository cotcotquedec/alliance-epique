  "7937": {
   "npc": 1000000,
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\1000000\\7937_detail.ogg",
    "master": "data/audio/world-events/darkmoon-faire/1000000/7937_detail.flac",
