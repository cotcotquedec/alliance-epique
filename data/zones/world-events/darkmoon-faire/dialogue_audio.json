  "14871_10168": {
   "npc": 14871,
   "page": "10168",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14871\\dialogue_10168.ogg",
    "master": "data/audio/world-events/darkmoon-faire/14871/dialogue_10168.flac",
    "dur": 13.6,
    "cps": 17.6,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 220408212,
    "scores": {
     "en": 0.0004,
     "fr": 0.9995,
     "wer": 0.065,
     "cps": 17.6,
     "secs": 13.6,
     "sim": 0.858
    },
    "text": "Je ne retrouve plus Jubjub, ma grenouille apprivoisée. Elle adore la bière sombrefer, elle ne boit que ça, mais c'est si dur d'en trouver ! Je suis tombée à court, et Jubjub a dû s'enfuir pour en trouver !\n\nJ'aimerais bien qu'elle revienne…",
    "stamp": {
     "voice": "q776953548",
     "voice_seed": 776953548
    },
    "created_at": "2026-10-11T05:27:32"
   }
  },
  "14871_10169": {
   "npc": 14871,
   "page": "10169",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14871\\dialogue_10169.ogg",
    "master": "data/audio/world-events/darkmoon-faire/14871/dialogue_10169.flac",
    "dur": 10.5,
    "cps": 19.4,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1002932873,
    "scores": {
     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.079,
     "cps": 19.4,
     "secs": 10.5,
     "sim": 0.762
    },
    "text": "Je suis si contente que vous ayez retrouvé Jubjub ! J'espère bien que je ne retomberai plus à court de bière sombrefer, car j'ai peur que ma grenouille apprivoisée ne s'enfuie à nouveau pour en trouver !",
    "stamp": {
     "voice": "q776953548",
     "voice_seed": 776953548
    },
    "created_at": "2026-10-11T05:27:33"
   }
  },
  "14829_10028": {
