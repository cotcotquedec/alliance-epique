    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1131166705,
    "scores": {
     "en": 0.0001,
     "fr": 0.9995,
     "wer": 0.0,
     "cps": 15.7,
     "secs": 5.5,
     "sim": 0.785
    },
    "text": "Merci encore! Ce que nous avons trouvé me satisfait grandement.\n\nBonne chance à vous !",
    "stamp": {
     "voice": "q1987848902",
     "voice_seed": 1987848902
    },
    "created_at": "2026-10-11T02:00:54"
   }
  },
  "10300_7466": {
   "npc": 10300,
   "page": "7466",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10300\\dialogue_7466.ogg",
    "master": "data/audio/kalimdor/ruttheran-village/10300/dialogue_7466.flac",
    "dur": 4.9,
    "cps": 18.6,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1610527046,
    "scores": {
     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.056,
     "cps": 18.6,
     "secs": 4.9,
     "sim": 0.813
    },
    "text": "Je m'apprête à franchir la crête. J'aurais bien besoin d'aide. Voulez-vous venir avec moi ?",
    "stamp": {
     "voice": "q1987848902",
     "voice_seed": 1987848902
    },
