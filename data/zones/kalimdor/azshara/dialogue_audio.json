    "cps": 13.4,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 268082169,
    "scores": {
     "en": 0.0001,
     "fr": 0.9995,
     "wer": 0.2,
     "cps": 13.4,
     "secs": 6.8,
     "sim": 0.846
    },
    "text": "Pas à n'importe quel poisson, mortelle. Ce poisson était un vairon. Un vairon exceptionnel.",
    "stamp": {
     "voice": "q1366054533",
     "voice_seed": 1366054533
    },
    "created_at": "2026-10-13T02:37:06",
    "refused": {
