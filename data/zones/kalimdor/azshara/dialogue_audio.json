     "at": "2026-10-13T02:37:06",
     "failed": [
      "wer"
     ]
    }
   }
  },
  "15481_11045": {
   "npc": 15481,
   "page": "11045",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15481\\dialogue_11045.ogg",
    "master": "data/audio/kalimdor/azshara/15481/dialogue_11045.flac",
    "dur": 8.6,
    "cps": 14.9,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1565180024,
    "scores": {
     "en": 0.001,
     "fr": 0.9976,
     "wer": 0.038,
     "cps": 14.9,
     "secs": 8.6,
     "sim": 0.848
    },
    "text": "Je suis un génie, je sais… On ne le trouvera jamais. Mais au cas où on le trouverait, j'ai donné des pouvoirs spéciaux au vairon.",
    "stamp": {
     "voice": "q1366054533",
     "voice_seed": 1366054533
    },
    "created_at": "2026-10-11T02:28:14"
   }
  },
  "15481_11047": {
   "npc": 15481,
   "page": "11047",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15481\\dialogue_11047.ogg",
    "master": "data/audio/kalimdor/azshara/15481/dialogue_11047.flac",
    "dur": 16.6,
    "cps": 16.0,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 840658354,
    "scores": {
     "en": 0.0003,
     "fr": 0.999,
     "wer": 0.041,
     "cps": 16.0,
     "secs": 16.6,
     "sim": 0.841
    },
    "text": "C'est cela. Vous m'avez bien écouté ! Ce vairon est une terrible créature de ma propre création. Pendant mes instants de repos, j'aime penser aux malheureux pêcheurs qui ont croisé la route de ce vairon et ont été dévorés tout entiers. Ils ont dû être bien surpris !",
    "stamp": {
     "voice": "q1366054533",
     "voice_seed": 1366054533
    },
    "created_at": "2026-10-11T02:28:16"
   }
  },
  "15481_11049": {
   "npc": 15481,
   "page": "11049",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15481\\dialogue_11049.ogg",
    "master": "data/audio/kalimdor/azshara/15481/dialogue_11049.flac",
    "dur": 12.6,
    "cps": 16.5,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1563590827,
    "scores": {
     "en": 0.0012,
     "fr": 0.998,
     "wer": 0.0,
     "cps": 16.5,
     "secs": 12.6,
     "sim": 0.867
    },
    "text": "Le génie est souvent incompris. Maintenant, en ce qui concerne ce fragment de sceptre... Si vous voulez le fragment sans passer les dix mille prochaines années à sa recherche, écoutez-moi bien attentivement.",
    "stamp": {
     "voice": "q1366054533",
     "voice_seed": 1366054533
    },
    "created_at": "2026-10-11T02:28:18"
   }
  },
  "15481_11053": {
   "npc": 15481,
   "page": "11053",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15481\\dialogue_11053.ogg",
    "master": "data/audio/kalimdor/azshara/15481/dialogue_11053.flac",
    "dur": 24.6,
    "cps": 15.8,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1242939616,
    "scores": {
     "en": 0.0005,
     "fr": 0.999,
     "wer": 0.044,
     "cps": 15.8,
     "secs": 24.6,
     "sim": 0.831
    },
    "text": "D'accord… Vous devez construire une bouée en arcanite et la placer dans l'océan. Mon vairon sera attiré par les émanations magiques. Quand il sera prêt de la bouée, BLAM ! Elle explosera en libérant une fabuleuse quantité d'énergie des arcanes, ce qui révélera la forme véritable du vairon. Il est également possible que vous subissiez la colère de Neptulon. J'estime les chances à 50-50.",
    "stamp": {
     "voice": "q1366054533",
     "voice_seed": 1366054533
    },
    "created_at": "2026-10-11T02:28:22"
   }
  },
  "15481_11056": {
   "npc": 15481,
   "page": "11056",
   "f": {
