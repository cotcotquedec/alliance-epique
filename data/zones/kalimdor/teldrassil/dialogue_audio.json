     "fr": 0.9995,
     "wer": 0.0,
     "cps": 16.1,
     "secs": 7.0,
     "sim": 0.852
    },
    "text": "La banque se trouve dans la sereine cité de Darnassus. C'est là que vous devez aller pour le dépôt de vos biens.",
    "stamp": {
     "voice": "q216315437",
     "voice_seed": 216315437
    },
    "created_at": "2026-10-10T17:33:09"
   }
  },
