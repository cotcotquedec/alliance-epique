  "6736_4309": {
   "npc": 6736,
   "page": "4309",
   "f": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\6736\\dialogue_4309_f.ogg",
    "master": "data/audio/kalimdor/teldrassil/6736/dialogue_4309_f.flac",
