     "wer": 0.045,
     "cps": 18.8,
     "secs": 8.0,
     "sim": 0.831
    },
    "text": "Vous trouverez de nombreux maîtres autour de Dolanaar, riches d'années d'expérience qu'ils vous transmettront. Lequel cherchez-vous plus précisément ?",
    "stamp": {
     "voice": "q216315437",
