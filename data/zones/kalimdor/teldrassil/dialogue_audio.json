     "wer": 0.148,
     "cps": 16.9,
     "secs": 8.7,
     "sim": 0.831
    },
    "text": "Pour atteindre le bac de Rut'theran, vous devez vous rendre à Darnassus et prendre le portail vers le village de Rut'theran, au pied de Teldrassil.",
    "stamp": {
     "voice": "q216315437",
     "voice_seed": 216315437
    },
