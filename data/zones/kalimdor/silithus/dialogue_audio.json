  "15179_10650": {
   "npc": 15179,
   "page": "10650",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15179\\dialogue_10650.ogg",
    "master": "data/audio/kalimdor/silithus/15179/dialogue_10650.flac",
    "dur": 5.7,
    "cps": 15.5,
