  "15190_10704": {
   "npc": 15190,
   "page": "10704",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15190\\dialogue_10704.ogg",
    "master": "data/audio/kalimdor/silithus/15190/dialogue_10704.flac",
    "dur": 6.6,
    "cps": 19.1,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 116320846,
    "scores": {
     "en": 0.0007,
     "fr": 0.9985,
     "wer": 0.042,
     "cps": 19.1,
     "secs": 6.6,
     "sim": 0.77
    },
    "text": "Hé ! Merci d’avoir sauvé ma peau ! Je pense que je vais faire profil bas pendant un moment, le temps de reprendre des forces.",
    "stamp": {
     "voice": "q840436677",
     "voice_seed": 840436677
    },
    "created_at": "2026-10-11T04:44:30"
   }
  },
  "15270_10754": {
   "npc": 15270,
   "page": "10754",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15270\\dialogue_10754.ogg",
    "master": "data/audio/kalimdor/silithus/15270/dialogue_10754.flac",
    "dur": 6.2,
    "cps": 17.2,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1611069858,
    "scores": {
     "en": 0.0011,
     "fr": 0.9976,
     "wer": 0.0,
     "cps": 17.2,
     "secs": 6.2,
     "sim": 0.831
    },
    "text": "Les esprits de Silithus nous appellent. La terre pleure, car elle a une histoire bouleversante à raconter…",
    "stamp": {
     "voice": "q922366841",
     "voice_seed": 922366841
    },
