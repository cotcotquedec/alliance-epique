    "scores": {
     "en": 0.0015,
     "fr": 0.9971,
     "wer": 0.024,
     "cps": 15.5,
     "secs": 14.6,
     "sim": 0.785
    },
    "text": "Ne vous méprenez pas, je préférerais être n’importe où plutôt que dans un tunnel plein de silithides. D’un autre côté, si en restant ici à les observer, j’aide à gagner la guerre, je continuerai aussi longtemps que nécessaire.",
    "stamp": {
     "voice": "q378967839",
     "voice_seed": 378967839
    },
    "created_at": "2026-10-11T05:05:05"
   }
  },
