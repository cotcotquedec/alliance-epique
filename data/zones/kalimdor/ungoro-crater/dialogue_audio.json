  "9270_5435": {
   "npc": 9270,
   "page": "5435",
   "f": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9270\\dialogue_5435_f.ogg",
    "master": "data/audio/kalimdor/ungoro-crater/9270/dialogue_5435_f.flac",
    "dur": 23.5,
    "cps": 16.4,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 2015854220,
    "scores": {
     "en": 0.0012,
     "fr": 0.998,
     "wer": 0.082,
     "cps": 16.4,
     "secs": 23.5,
     "sim": 0.901
    },
    "text": "Salut à toi, étrangère ! Bienvenue au majestueux et sauvage Cratère d'Un'Goro !\n\nJe me nomme Williden Marshal. Ma soeur, mes compagnons et moi avons créé les Expéditions Marshal : des scientifiques et des explorateurs s'aventurant dans les grandes régions inconnues d'Azeroth.\n\nNous avons rencontré quelques déconvenues ici, et votre aide sera la bienvenue, si vous en avez le temps...",
    "stamp": {
     "voice": "q23206176",
     "voice_seed": 23206176
    },
    "created_at": "2026-10-11T15:56:52"
   },
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9270\\dialogue_5435.ogg",
    "master": "data/audio/kalimdor/ungoro-crater/9270/dialogue_5435.flac",
    "dur": 25.3,
    "cps": 15.2,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 289700005,
    "scores": {
     "en": 0.0013,
     "fr": 0.998,
     "wer": 0.115,
     "cps": 15.2,
     "secs": 25.3,
     "sim": 0.906
    },
    "text": "Salut à toi, étranger ! Bienvenue au majestueux et sauvage Cratère d'Un'Goro !\n\nJe me nomme Williden Marshal. Ma soeur, mes compagnons et moi avons créé les Expéditions Marshal : des scientifiques et des explorateurs s'aventurant dans les grandes régions inconnues d'Azeroth.\n\nNous avons rencontré quelques déconvenues ici, et votre aide sera la bienvenue, si vous en avez le temps...",
    "stamp": {
     "voice": "q23206176",
     "voice_seed": 23206176
    },
    "created_at": "2026-10-11T02:05:46"
   }
  },
  "9271_5434": {
   "npc": 9271,
   "page": "5434",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9271\\dialogue_5434.ogg",
    "master": "data/audio/kalimdor/ungoro-crater/9271/dialogue_5434.flac",
    "dur": 18.0,
    "cps": 17.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 333303981,
    "scores": {
     "en": 0.0003,
     "fr": 0.999,
     "wer": 0.058,
     "cps": 17.7,
     "secs": 18.0,
     "sim": 0.782
    },
    "text": "Oh, bien le bonjour ! Je suis Hol'anyee, la scientifique et biologiste en charge des Expéditions Marshal. Mon frère et moi, ainsi que nos compagnons, traversons Azeroth en explorant sa beauté sauvage et encore vierge. C'est si passionnant... Mais je crains que nous ne nous soyons montrés trop passionnés cette fois...",
    "stamp": {
     "voice": "q1952840357",
     "voice_seed": 1952840357
    },
    "created_at": "2026-10-11T15:56:55"
   }
  },
