    "scores": {
     "en": 0.0006,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 16.0,
     "secs": 2.6,
     "sim": 0.808
    },
    "text": "Laissez reposer en paix un esprit ancien.",
    "stamp": {
