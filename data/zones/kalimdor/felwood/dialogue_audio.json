     "fr": 0.9976,
     "wer": 0.0,
     "cps": 19.5,
     "secs": 4.2,
     "sim": 0.768
    },
    "text": "Vous êtes là pour une formation qui vous permettrait de fortifier vos familiers ?",
    "stamp": {
