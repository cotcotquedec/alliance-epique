  "11556_7138": {
   "npc": 11556,
   "page": "7138",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\11556\\dialogue_7138.ogg",
    "master": "data/audio/kalimdor/felwood/11556/dialogue_7138.flac",
    "dur": 7.0,
    "cps": 17.5,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1637292878,
    "scores": {
     "en": 0.0001,
     "fr": 0.9995,
     "wer": 0.0,
     "cps": 17.5,
     "secs": 7.0,
     "sim": 0.572
    },
    "text": "Nous autres, les Grumegueules, pouvons vous aider à passer en sécurité, mais vous devez nous prouver d'abord votre amitié.",
    "stamp": {
