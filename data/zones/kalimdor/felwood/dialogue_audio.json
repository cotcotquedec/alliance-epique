  "9465_8323": {
   "npc": 9465,
   "page": "8323",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9465\\dialogue_8323.ogg",
    "master": "data/audio/kalimdor/felwood/9465/dialogue_8323.flac",
    "dur": 15.5,
    "cps": 14.4,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 86824044,
    "scores": {
     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.0,
     "cps": 14.4,
     "secs": 15.5,
     "sim": 0.816
    },
    "text": "Bienvenue. Si vous êtes ici pour apprendre, ce sera un honneur pour moi de vous y aider.\n\nNous sommes les gardiens de l'équilibre, aujourd'hui et à jamais, tandis que Malfurion est plongé dans le Rêve. Ne l'oubliez jamais.",
    "stamp": {
     "voice": "q1728430208",
     "voice_seed": 1728430208
    },
    "created_at": "2026-10-11T02:07:02"
   }
  },
