     "fr": 0.9995,
     "wer": 0.0,
     "cps": 18.6,
     "secs": 4.7,
     "sim": 0.758
    },
    "text": "Le Temple englouti se trouve au centre d'un grand lac dans l'est du marais des Chagrins.",
    "stamp": {
     "voice": "q1144465508",
     "voice_seed": 1144465508
    },
    "created_at": "2026-10-13T10:06:08"
   }
