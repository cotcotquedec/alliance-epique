     "wer": 0.111,
     "cps": 12.5,
     "secs": 3.8,
     "sim": 0.723
    },
    "text": "Gnomeregan se trouve dans l'ouest de Dun Morogh.",
    "stamp": {
     "voice": "q1144465508",
     "voice_seed": 1144465508
    },
    "created_at": "2026-10-13T01:21:38"
