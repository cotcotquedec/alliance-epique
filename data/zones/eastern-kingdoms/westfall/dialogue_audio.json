    "dur": 7.8,
    "cps": 19.8,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1124718729,
    "scores": {
     "en": 0.0008,
     "fr": 0.998,
     "wer": 0.036,
     "cps": 19.8,
     "secs": 7.8,
     "sim": 0.822
    },
    "text": "Où que c'est qu'vous voulez aller, l'ami ? Pour quelques pièces, mes gryphons peuvent vous faire une monture plus rapide qu'le plus rapide des canassons !",
    "stamp": {
     "voice": "q1347382459",
     "voice_seed": 1347382459
    },
    "created_at": "2026-10-10T19:39:40"
   }
