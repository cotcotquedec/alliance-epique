     "cps": 14.4,
     "secs": 4.2,
     "sim": 0.759
    },
    "text": "Les ruines de Hache-Tripes se trouvent au centre de Féralas.",
    "stamp": {
     "voice": "q1144465508",
     "voice_seed": 1144465508
    },
    "created_at": "2026-10-13T21:22:57",
