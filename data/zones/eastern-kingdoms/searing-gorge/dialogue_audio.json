    "master": "data/audio/eastern-kingdoms/searing-gorge/14626/dialogue_9824.flac",
    "dur": 19.1,
    "cps": 17.6,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1415466202,
