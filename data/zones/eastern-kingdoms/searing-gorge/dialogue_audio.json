    },
    "text": "Confrérie du Thorium ou pas, si un de ces Sombrefer s’approche trop, il va se prendre un bon coup de pioche sur le coin de la figure ! Bon, où puis-je vous envoyer, ma fille ?",
    "stamp": {
     "voice": "q1312414266",
     "voice_seed": 1312414266
    },
    "created_at": "2026-10-11T01:12:48"
   },
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\2941\\dialogue_9828.ogg",
    "master": "data/audio/eastern-kingdoms/searing-gorge/2941/dialogue_9828.flac",
    "dur": 9.4,
    "cps": 18.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1065984015,
    "scores": {
     "en": 0.0003,
     "fr": 0.999,
     "wer": 0.056,
     "cps": 18.7,
     "secs": 9.4,
     "sim": 0.836
    },
    "text": "Confrérie du Thorium ou pas, si un de ces Sombrefer s’approche trop, il va se prendre un bon coup de pioche sur le coin de la figure ! Bon, où puis-je vous envoyer, mon gars ?",
    "stamp": {
     "voice": "q1312414266",
     "voice_seed": 1312414266
    },
    "created_at": "2026-10-11T01:12:49"
   }
