  "9836_5290": {
   "npc": 9836,
   "page": "5290",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9836\\dialogue_5290.ogg",
    "master": "data/audio/eastern-kingdoms/burning-steppes/9836/dialogue_5290.flac",
