    "cps": 14.8,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1480374259,
    "scores": {
     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.038,
     "cps": 14.8,
     "secs": 12.4,
     "sim": 0.89
    },
    "text": "Ah, ainsi... vous l'avez trouvé.\n\nMathredis montre le livre en votre possession.\n\nAvez-vous récupéré les composants nécessaires ?\n\nLes manifestations listées dans le Libram, imbécile !",
    "stamp": {
     "voice": "q1860997982",
     "voice_seed": 1860997982
    },
    "created_at": "2026-10-11T01:56:39"
   }
  },
