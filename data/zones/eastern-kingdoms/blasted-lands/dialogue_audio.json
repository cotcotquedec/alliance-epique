    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 422166150,
    "scores": {
     "en": 0.0001,
     "fr": 0.9995,
     "wer": 0.071,
     "cps": 16.0,
     "secs": 4.6,
     "sim": 0.781
    },
    "text": "Je suis lié pour l'éternité à ce monde maudit. Que désires-tu, mortelle ?",
