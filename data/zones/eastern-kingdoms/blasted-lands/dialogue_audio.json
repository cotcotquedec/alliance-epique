     "fr": 0.9995,
     "wer": 0.0,
     "cps": 15.3,
     "secs": 4.6,
     "sim": 0.806
    },
    "text": "Je suis lié pour l'éternité à ce monde maudit. Que désires-tu, mortel ?",
    "stamp": {
     "voice": "q956873843",
     "voice_seed": 956873843
    },
    "created_at": "2026-10-11T01:57:12"
   },
