     "en": 0.0005,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 15.2,
     "secs": 4.1,
     "sim": 0.75
    },
    "text": "Ta récompense sera une morte rapide et douloureuse, imbécile !",
    "stamp": {
