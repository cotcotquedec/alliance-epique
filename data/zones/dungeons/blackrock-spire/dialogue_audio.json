  "10776_6078": {
   "npc": 10776,
   "page": "6078",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10776\\dialogue_6078.ogg",
    "master": "data/audio/dungeons/blackrock-spire/10776/dialogue_6078.flac",
