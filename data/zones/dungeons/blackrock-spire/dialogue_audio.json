  "9563_5414": {
   "npc": 9563,
   "page": "5414",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9563\\dialogue_5414.ogg",
    "master": "data/audio/dungeons/blackrock-spire/9563/dialogue_5414.flac",
    "dur": 13.4,
    "cps": 16.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1846870425,
    "scores": {
     "en": 0.0015,
     "fr": 0.9971,
     "wer": 0.122,
     "cps": 16.7,
     "secs": 13.4,
     "sim": 0.779
    },
    "text": "Très bien *hic*...Dites, vous avez l'air familier *hic*. Je vous ai déjà raconté quand j'étais avec Windsor et qu'on a combattu tren... heu, mil... heu, un million d'orcs ?\n\nOh, préparez-vous, c'est une excellente histoire !",
    "stamp": {
     "voice": "q226727368",
     "voice_seed": 226727368
    },
    "created_at": "2026-10-11T03:28:02"
   }
  },
  "9563_5834": {
   "npc": 9563,
   "page": "5834",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\9563\\dialogue_5834.ogg",
    "master": "data/audio/dungeons/blackrock-spire/9563/dialogue_5834.flac",
    "dur": 4.6,
    "cps": 16.7,
