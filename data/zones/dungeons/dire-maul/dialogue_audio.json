    "seed": 586339257,
    "scores": {
     "en": 0.0003,
     "fr": 0.999,
     "wer": 0.05,
     "cps": 15.9,
     "secs": 7.6,
     "sim": 0.81
    },
    "text": "Ils ont été volés! Trois de nos livres les plus précieux. Si vous nous les retrouvez, vous serez certainement récompensé.",
    "stamp": {
     "voice": "q1958620396",
     "voice_seed": 1958620396
    },
    "created_at": "2026-10-11T02:57:29"
   },
