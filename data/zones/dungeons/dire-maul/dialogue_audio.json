  "10877_9551": {
   "npc": 10877,
   "page": "9551",
   "f": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10877\\dialogue_9551_f.ogg",
    "master": "data/audio/dungeons/dire-maul/10877/dialogue_9551_f.flac",
    "dur": 8.3,
    "cps": 16.6,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1795842270,
    "scores": {
     "en": 0.0014,
     "fr": 0.9961,
     "wer": 0.045,
     "cps": 16.6,
     "secs": 8.3,
     "sim": 0.766
    },
    "text": "Salutations, héroïne ! Je connais les dernières nouvelles des deux continents et de bien au-delà, et je les soumets à votre considération.",
    "stamp": {
     "voice": "q98994800",
     "voice_seed": 98994800
    },
    "created_at": "2026-10-12T13:47:22"
   },
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10877\\dialogue_9551.ogg",
    "master": "data/audio/dungeons/dire-maul/10877/dialogue_9551.flac",
    "dur": 8.2,
    "cps": 16.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 2118375400,
    "scores": {
     "en": 0.0014,
     "fr": 0.9961,
     "wer": 0.0,
     "cps": 16.7,
     "secs": 8.2,
     "sim": 0.848
    },
    "text": "Salutations, héros ! Je connais les dernières nouvelles des deux continents et de bien au-delà, et je les soumets à votre considération.",
    "stamp": {
     "voice": "q98994800",
     "voice_seed": 98994800
    },
