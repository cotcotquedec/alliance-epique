  "11491_9102": {
   "npc": 11491,
   "page": "9102",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\11491\\dialogue_9102.ogg",
    "master": "data/audio/dungeons/dire-maul/11491/dialogue_9102.flac",
    "dur": 17.2,
    "cps": 14.8,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1544463930,
    "scores": {
     "en": 0.0001,
     "fr": 0.999,
     "wer": 0.043,
     "cps": 14.8,
     "secs": 17.2,
     "sim": 0.907
    },
    "text": "Merci, mortel. Avant que je ne regagne le Rêve, il est un service que je puis vous rendre.\n\nLa porte qui mène à Alzzin, le maître de Zevrim, bloque votre passage. Je serai votre instrument de destruction. La porte sera ouverte, j'attends juste vos ordres.",
    "stamp": {
     "voice": "q1720547975",
     "voice_seed": 1720547975
    },
    "created_at": "2026-10-11T02:56:30"
   }
  },
  "14358_9379": {
   "npc": 14358,
   "page": "9379",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14358\\dialogue_9379.ogg",
