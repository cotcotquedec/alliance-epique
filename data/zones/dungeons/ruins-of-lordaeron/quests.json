 "quests": {
  "92415": {
   "id": 92415,
   "name": "N’oublie pas que je t’aime",
   "objectives": "Apportez la lettre tachée de sang à la directrice de l’orphelinat Rossignol, à Hurlevent.",
   "description": "<Une liasse de parchemins, déchirée et maculée, a de justesse survécu aux terres du cimetière foulées par les morts-vivants. Il y est fait mention d’un enfant disparu de la famille Tissecœur. La directrice de l’orphelinat, à Hurlevent, en saura peut-être davantage.>",
   "progress": null,
   "completion": "Tissecœur ? Tissecœur…\r\n\r\nOh, le petit Jérémy Tissecœur. On nous l’a amené voilà des années, après l’attaque de Lordaeron. Il a perdu ses deux parents dans l’assaut, le pauvre.\r\n\r\nÀ vrai dire, il a été adopté il n’y a pas si longtemps par une femme charmante, du côté du bois de la Pénombre.",
   "starters": [
    {
     "type": "item",
     "id": 251270,
     "name": "Blood-Stained Parchment"
    },
    {
     "type": "item",
     "id": 251520,
     "name": "Last Scrawlings of Edward Heartweaver"
    }
   ],
