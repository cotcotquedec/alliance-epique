    "scores": {
     "en": 0.0008,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 17.2,
     "secs": 9.7,
     "sim": 0.85
    },
    "text": "Tel un chat chassé par la pluie, vous grattez et griffez encore et encore... Je reviendrai plus tard...\n\nOh, je ne vous ai pas vu entrer! Que puis-je faire pour vous ?",
    "stamp": {
     "voice": "q1828852369",
     "voice_seed": 1828852369
    },
    "created_at": "2026-10-10T19:13:35"
   }
  },
  "3599_7477": {
   "npc": 3599,
   "page": "7477",
