     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.071,
     "cps": 17.3,
     "secs": 5.0,
     "sim": 0.842
    },
    "text": "Des messagers de Ravenholdt ont apporté cette lettre ce matin. Elle vous est destinée.",
    "stamp": {
     "voice": "q1947255085",
     "voice_seed": 1947255085
    },
    "created_at": "2026-10-10T19:14:02"
   }
  },
