  "14436_9584": {
   "npc": 14436,
   "page": "9584",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14436\\dialogue_9584.ogg",
    "master": "data/audio/classes/warlock/14436/dialogue_9584.flac",
    "dur": 13.0,
    "cps": 18.9,
    "model": "qwen3-tts-1.7b-base",
