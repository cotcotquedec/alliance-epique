  "6382_8403": {
   "npc": 6382,
   "page": "8403",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\6382\\dialogue_8403.ogg",
    "master": "data/audio/classes/warlock/6382/dialogue_8403.flac",
