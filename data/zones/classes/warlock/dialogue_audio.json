    "scores": {
     "en": 0.0008,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 18.9,
     "secs": 13.0,
     "sim": 0.878
    },
    "text": "Il arrive un moment où la vie que nous menons n'a plus d'intérêt. Nous sommes piégés et nous cherchons des réponses, et nous finissons par trouver l'espoir dans les ténèbres..\n\nCe n'est qu'alors, que nous faisons nos premiers pas vers la liberté.",
    "stamp": {
     "voice": "q340096600",
     "voice_seed": 340096600
    },
    "created_at": "2026-10-11T00:33:38"
   }
  },
  "14437_9585": {
   "npc": 14437,
   "page": "9585",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14437\\dialogue_9585.ogg",
    "master": "data/audio/classes/warlock/14437/dialogue_9585.flac",
    "dur": 7.0,
    "cps": 20.9,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 830352670,
    "scores": {
     "en": 0.0013,
     "fr": 0.9961,
     "wer": 0.0,
     "cps": 20.9,
     "secs": 7.0,
     "sim": 0.857
    },
    "text": "Avez-vous des araignées ou des scarabées? Ils détalent à toute vitesse, mais si vous êtes plus rapide qu'eux, vous verrez qu'ils sont délectables !",
    "stamp": {
     "voice": "q1341286774",
     "voice_seed": 1341286774
    },
    "created_at": "2026-10-11T00:33:40"
   }
  },
