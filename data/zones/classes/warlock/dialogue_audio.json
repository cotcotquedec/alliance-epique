     "fr": 0.9995,
     "wer": 0.0,
     "cps": 16.0,
     "secs": 6.6,
     "sim": 0.818
    },
    "text": "Les arcanes ne corrompent que les faibles. Continuez votre formation ou vous connaîtrez un sort similaire.",
    "stamp": {
     "voice": "q1167757521",
     "voice_seed": 1167757521
    },
    "created_at": "2026-10-11T00:31:39"
   }
  },
  "461_8300": {
   "npc": 461,
   "page": "8300",
   "m": {
