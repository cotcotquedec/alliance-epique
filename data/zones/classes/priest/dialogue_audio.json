    },
    "created_at": "2026-10-10T17:47:41"
   }
  },
  "14494_9717": {
   "npc": 14494,
   "page": "9717",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14494\\dialogue_9717.ogg",
    "master": "data/audio/classes/priest/14494/dialogue_9717.flac",
    "dur": 11.2,
    "cps": 13.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 774321981,
    "scores": {
     "en": 0.0008,
     "fr": 0.9976,
     "wer": 0.0,
     "cps": 13.7,
     "secs": 11.2,
     "sim": 0.827
    },
    "text": "L’Œil a vu maintes horreurs et maintes merveilles.\n\nIl montre ce que la personne qui regarde dans ses profondeurs est, à son avis, la plus à même de voir.",
    "stamp": {
     "voice": "q1428779633",
     "voice_seed": 1428779633
    },
    "created_at": "2026-10-10T17:47:43"
   }
  },
  "14494_9719": {
   "npc": 14494,
   "page": "9719",
   "f": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14494\\dialogue_9719_f.ogg",
    "master": "data/audio/classes/priest/14494/dialogue_9719_f.flac",
    "dur": 15.3,
    "cps": 15.9,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 2032401558,
    "scores": {
     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.022,
     "cps": 15.9,
     "secs": 15.3,
     "sim": 0.805
    },
    "text": "Oui. L’Œil ne se trompe jamais.\n\nVous êtes une prêtresse, après tout. Et d’une grande puissance, pour que l’Œil vous montre ce souvenir horrible.\n\nVous êtes venue chercher une rédemption, même si vous ne le réalisez pas encore… N’est-ce pas ?",
    "stamp": {
     "voice": "q1428779633",
     "voice_seed": 1428779633
    },
    "created_at": "2026-10-10T17:47:45"
   },
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\14494\\dialogue_9719.ogg",
    "master": "data/audio/classes/priest/14494/dialogue_9719.flac",
    "dur": 14.8,
    "cps": 16.0,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 456573873,
    "scores": {
     "en": 0.0002,
     "fr": 0.9995,
     "wer": 0.0,
     "cps": 16.0,
     "secs": 14.8,
     "sim": 0.784
    },
    "text": "Oui. L’Œil ne se trompe jamais.\n\nVous êtes un prêtre, après tout. Et d’une grande puissance, pour que l’Œil vous montre ce souvenir horrible.\n\nVous êtes venu chercher une rédemption, même si vous ne le réalisez pas encore… N’est-ce pas ?",
    "stamp": {
     "voice": "q1428779633",
