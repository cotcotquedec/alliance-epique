   }
  },
  "913_8260": {
   "npc": 913,
   "page": "8260",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\913\\dialogue_8260.ogg",
    "master": "data/audio/classes/warrior/913/dialogue_8260.flac",
    "dur": 16.4,
    "cps": 21.2,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 666098366,
    "scores": {
     "en": 0.0007,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 21.2,
     "secs": 16.4,
     "sim": 0.772
    },
    "text": "À travers un vigoureux recyclage, j'ai dû contraindre bien des étudiants à oublier ce qu'ils avaient appris, afin qu'ils soient prêts à recevoir mon enseignement. Le service que je propose devient de plus en plus difficile à accomplir. C'est pour cela que c'est sans cesse plus cher. Voulez-vous que je vous fasse oublier ce que vous avez appris ?",
    "stamp": {
     "voice": "q1081487303",
     "voice_seed": 1081487303
    },
    "created_at": "2026-10-10T20:59:15"
   }
  },
  "1229_8302": {
   "npc": 1229,
   "page": "8302",
   "f": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\1229\\dialogue_8302_f.ogg",
    "master": "data/audio/classes/warrior/1229/dialogue_8302_f.flac",
    "dur": 12.2,
    "cps": 14.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1608192055,
    "scores": {
     "en": 0.0015,
     "fr": 0.9971,
     "wer": 0.0,
     "cps": 14.7,
     "secs": 12.2,
     "sim": 0.894
    },
    "text": "Vous n'êtes pas un guerrier... Le dernier camarade que j'ai entraîné n'a même pas tenu une journée.\n\nRegardez-moi ça, encore une petite futée qui se prend pour un guerrier... Ah !",
    "stamp": {
     "voice": "q751351451",
     "voice_seed": 751351451
    },
    "created_at": "2026-10-10T21:16:15"
   },
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\1229\\dialogue_8302.ogg",
    "master": "data/audio/classes/warrior/1229/dialogue_8302.flac",
