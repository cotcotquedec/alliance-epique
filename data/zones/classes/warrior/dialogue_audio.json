    "cps": 15.0,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 740822478,
    "scores": {
     "en": 0.0013,
     "fr": 0.9971,
     "wer": 0.0,
     "cps": 15.0,
     "secs": 11.7,
     "sim": 0.867
    },
    "text": "Vous n'êtes pas un guerrier... Le dernier camarade que j'ai entraîné n'a même pas tenu une journée.\n\nRegardez-moi ça, encore un gros malin qui se prend pour un guerrier... Ah !",
    "stamp": {
     "voice": "q751351451",
     "voice_seed": 751351451
    },
    "created_at": "2026-10-10T21:16:17"
   }
