    "scores": {
     "en": 0.0004,
     "fr": 0.999,
     "wer": 0.0,
     "cps": 19.0,
     "secs": 18.2,
     "sim": 0.835
    },
    "text": "À travers un vigoureux recyclage, j'ai dû contraindre bien des étudiants à oublier ce qu'ils avaient appris, afin qu'ils soient prêts à recevoir mon enseignement. Le service que je propose devient de plus en plus difficile à accomplir. C'est pour cela que c'est sans cesse plus cher. Voulez-vous que je vous fasse oublier ce que vous avez appris ?",
    "stamp": {
     "voice": "q129201075",
     "voice_seed": 129201075
    },
    "created_at": "2026-10-10T20:49:04"
   }
  },
  "911_8299": {
   "npc": 911,
   "page": "8299",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\911\\dialogue_8299.ogg",
    "master": "data/audio/classes/warrior/911/dialogue_8299.flac",
    "dur": 10.8,
    "cps": 15.4,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 244541869,
    "scores": {
     "en": 0.0007,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 15.4,
     "secs": 10.8,
     "sim": 0.879
    },
    "text": "Rien qu'à votre posture, je peux dire que vous n'êtes pas un guerrier.\n\nAllez plutôt vous livrer à quelque activité sans danger... Lire un livre, ce genre de choses...",
    "stamp": {
     "voice": "q129201075",
     "voice_seed": 129201075
    },
    "created_at": "2026-10-10T20:49:39"
   }
  },
