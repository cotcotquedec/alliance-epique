  "15502_12848": {
   "npc": 15502,
   "page": "12848",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15502\\dialogue_12848.ogg",
    "master": "data/audio/raids/ahnqiraj/15502/dialogue_12848.flac",
    "dur": 11.1,
    "cps": 18.9,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 545417153,
    "scores": {
     "en": 0.0016,
     "fr": 0.9966,
     "wer": 0.027,
     "cps": 18.9,
     "secs": 11.1,
     "sim": 0.827
    },
    "text": "Depuis que l’empereur a été tué, la protection magique qui empêche la téléportation à l’intérieur du temple s’est grandement affaiblie. Si vous le désirez, je peux vous transposer dans le repaire de l’empereur.",
    "stamp": {
     "voice": "q565844624",
     "voice_seed": 565844624
    },
    "created_at": "2026-10-11T23:50:54",
