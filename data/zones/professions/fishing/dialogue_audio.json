  "15077_10475": {
   "npc": 15077,
   "page": "10475",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\15077\\dialogue_10475.ogg",
    "master": "data/audio/professions/fishing/15077/dialogue_10475.flac",
    "dur": 19.5,
    "cps": 18.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 2008222416,
    "scores": {
     "en": 0.0006,
     "fr": 0.9985,
     "wer": 0.092,
     "cps": 18.7,
     "secs": 19.5,
     "sim": 0.886
    },
    "text": "Bienvenue au concours de pêche de la Baie-du-Butin, qui nous permet de désigner toutes les semaines notre grand Maître pêcheur !\n\nEntre 14 h et 16 h, des bancs de courbines longent les côtes de Strangleronce. Si votre flotteur tombe dans l’un de ces bancs lorsque vous pêchez, vous prendrez l’un des poissons du banc plutôt que les prises normales de Strangleronce.",
    "stamp": {
     "voice": "q153700058",
     "voice_seed": 153700058
    },
    "created_at": "2026-10-11T05:44:18"
   }
  },
