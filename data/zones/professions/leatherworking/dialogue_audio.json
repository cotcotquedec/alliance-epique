    "scores": {
     "en": 0.0008,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 15.9,
     "secs": 7.0,
     "sim": 0.852
    },
    "text": "Si vous êtes ici pour tuer des dragons, faites comme bon vous semble ! À qui dois-je envoyer mes condoléances ?",
    "stamp": {
     "voice": "q1295379853",
     "voice_seed": 1295379853
    },
