  "10637_6130": {
   "npc": 10637,
   "page": "6130",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10637\\dialogue_6130.ogg",
    "master": "data/audio/professions/blacksmithing/10637/dialogue_6130.flac",
    "dur": 14.6,
    "cps": 18.5,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1984955314,
    "scores": {
     "en": 0.0003,
     "fr": 0.9995,
     "wer": 0.0,
     "cps": 18.5,
     "secs": 14.6,
     "sim": 0.859
    },
    "text": "C'est très simple pour un artisan de mon calibre.\n\nLe plus difficile, dans le traitement des peaux et des carapaces, c'est de les trouver. Si vous pouviez m'apporter une dépouille de cette bête en parfait état, je pourrais faire plusieurs puissants objets avec sa chair.",
    "stamp": {
     "voice": "q1387393958",
     "voice_seed": 1387393958
    },
    "created_at": "2026-10-11T23:36:15"
   }
  },
  "10637_6132": {
   "npc": 10637,
   "page": "6132",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10637\\dialogue_6132.ogg",
    "master": "data/audio/professions/blacksmithing/10637/dialogue_6132.flac",
    "dur": 14.6,
    "cps": 17.7,
    "model": "qwen3-tts-1.7b-base",
    "engine": "Qwen/Qwen3-TTS-12Hz-1.7B-Base (cuda)",
    "seed": 1409683269,
    "scores": {
     "en": 0.0005,
     "fr": 0.9985,
     "wer": 0.0,
     "cps": 17.7,
     "secs": 14.6,
     "sim": 0.851
    },
    "text": "Je dois dire que les chances de trouver une telle pièce sont d'une sur un million ! La chance d'une vie ! Même l'artisan le plus discipliné échouerait sans doute plusieurs centaines de fois en dépeçant la bête avant d'obtenir un échantillon en parfait état.",
    "stamp": {
     "voice": "q1387393958",
     "voice_seed": 1387393958
    },
    "created_at": "2026-10-11T23:36:17"
   }
  },
  "10637_6134": {
   "npc": 10637,
   "page": "6134",
   "m": {
    "file": "Interface\\AddOns\\ForeverSpeech\\audio\\10637\\dialogue_6134.ogg",
    "master": "data/audio/professions/blacksmithing/10637/dialogue_6134.flac",
