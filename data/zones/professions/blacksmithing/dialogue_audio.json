     "fr": 0.9966,
     "wer": 0.0,
     "cps": 16.7,
     "secs": 4.7,
     "sim": 0.776
    },
    "text": "Si vous m'apportiez la peau de cette bête ? Ma foi... Laissez-moi vous montrer.",
    "stamp": {
     "voice": "q1387393958",
     "voice_seed": 1387393958
    },
    "created_at": "2026-10-11T23:45:01"
   }
  },
