    "scores": {
     "en": 0.0021,
     "fr": 0.9961,
     "wer": 0.062,
     "cps": 19.2,
     "secs": 7.9,
     "sim": 0.806
    },
    "text": "N'est-ce pas ? C'est un beau boulot que vous avez fait là. J'vous prends comme élève, pardi ! Bientôt vous f'rez des armures pour le roi Magni lui-même.",
    "stamp": {
     "voice": "q1517798442",
     "voice_seed": 1517798442
    },
